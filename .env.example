# AetherWatch lite · field live cache (copy to .env — never commit secrets)
#
# Ocean (OSCAR v2 NRT via NASA Earthdata / PO.DAAC)
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
CURRENT_SOURCE=auto
# auto|oscar → try OSCAR when creds present; demo → force static packs

# Disk cache (gitignored)
FIELD_CACHE_DIR=.cache/fields
FIELD_CACHE_TTL_SECONDS=21600

# Optional CMR overrides
OSCAR_SHORT_NAME=OSCAR_L4_OC_NRT_V2.0
OSCAR_COLLECTION_ID=C2102958977-POCLOUD

# Wind / temp / precip (Open-Meteo forecast · free, no key required)
OPEN_METEO_SOURCE=auto
# auto|om → fetch OM; demo → force static packs
OPEN_METEO_BASE=https://api.open-meteo.com
OPEN_METEO_API_KEY=
OPEN_METEO_MODEL=
# Global sample step only (china/regional use built-in defaults). Free tier: 10
OPEN_METEO_STEP_DEG=10
OPEN_METEO_BATCH=50
OPEN_METEO_PAUSE_MS=3500
