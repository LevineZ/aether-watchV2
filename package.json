{
  "name": "aether-demo-shell",
  "private": true,
  "version": "0.1.0",
  "description": "AetherWatch 演示轻仓：三页场可视化壳，FieldFrame 唯一交换形状",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-demo-packs.mjs",
    "generate:precip": "node scripts/generate-demo-packs.mjs --precip-only",
    "dev": "pnpm generate && pnpm --filter @aether/web dev",
    "build": "pnpm generate && pnpm --filter @aether/web build",
    "start": "node apps/web/server.mjs",
    "preview": "pnpm build && PORT=8765 HOST=0.0.0.0 node apps/web/server.mjs",
    "typecheck": "pnpm --filter @aether/web typecheck",
    "test:field": "node --experimental-strip-types --test packages/field/src/*.test.ts",
    "test": "node --experimental-strip-types --test packages/field/src/*.test.ts packages/particles/src/*.test.ts",
    "cache:ocean": "node scripts/field-cache/cli.mjs ensure global/ocean",
    "cache:status": "node scripts/field-cache/cli.mjs status",
    "cache:ocean:py": ".venv-field/bin/python scripts/field-cache/fetch_oscar.py --pack global/ocean",
    "cache:regional": "node scripts/field-cache/cli.mjs ensure regional/currents",
    "cache:wind": "node scripts/field-cache/cli.mjs ensure global/wind",
    "cache:temp": "node scripts/field-cache/cli.mjs ensure global/temp",
    "cache:precip": "node scripts/field-cache/cli.mjs ensure global/precip",
    "cache:om": "node scripts/field-cache/cli.mjs ensure global/wind",
    "cache:china": "node scripts/field-cache/cli.mjs ensure china/wind"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
